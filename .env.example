# ── Engine keys (any subset) ──────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# PERPLEXITY_API_KEY=

# ── Engines & models ──────────────────────────────────────────────────────
GEO_DEFAULT_ENGINES=claude,chatgpt,gemini
# GEO_CLAUDE_MODEL=claude-sonnet-5-5
# GEO_CHATGPT_MODEL=gpt-6.1-sol
# GEO_GEMINI_MODEL=gemini-3.8-flash
# GEO_JUDGE_PROVIDER=auto
# GEO_ANALYST_MODEL=claude-sonnet-5-5
# GEO_MAX_QUERIES_PER_RUN=60

# ── HTTP server ───────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
GEO_MCP_TOKEN=
# Public hostname(s) when served through a tunnel / reverse proxy
# GEO_MCP_ALLOWED_HOSTS=geo-mcp.example.com
# GEO_PUBLIC_BASE_URL=https://geo-mcp.example.com
# Peers whose X-Forwarded-* headers may be believed (IP or CIDR). Unset = ignored.
# GEO_MCP_TRUSTED_PROXIES=127.0.0.1

# ── Notifications ─────────────────────────────────────────────────────────
# Slack-compatible incoming webhook, posted on every completed run
# GEO_WEBHOOK_URL=https://hooks.slack.com/services/...
